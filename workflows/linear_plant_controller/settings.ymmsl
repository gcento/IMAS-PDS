ymmsl_version: v0.2

# Generic settings for linear_plant_controller, stacked after workflow.ymmsl by
# bin/pds-create-case / bin/pds-run-case.sbatch. ${SHOT} is filled in by pds-create-case.
# The pulse window (source.t_min/t_max, plant.t_end) and the plant model
# (plant.linear_model_dir, plant.operating_point) are per shot: every shot needs
# cases/overrides/linear_plant_controller_<shot>.ymmsl. A key set there wins over the
# value here. 

settings:
  # Initial state: built once by preprocess.sh (with waveforms.yaml of this folder) at
  # case creation: NICE inverse equilibrium and pf_active of preprocess.source_uri
  # (default: out_nice of a completed inverse_convergence run for the same shot), window
  # source.t_min/t_max, written to ${CASE_DIR}/preprocess/initial_state. The run starts at
  # the first time of the window (t0); the controller takes its references from the same
  # entry.
  preprocess.source_uri: "imas:hdf5?path=${PDS_REPO}/cases/runs/inverse_convergence_${SHOT}/out_nice"
  source.source_uri: "imas:hdf5?path=${CASE_DIR}/preprocess/initial_state"
  source.iterative: False
  source.t_min: 0.0

  # Exchange period (s): the plant step, the plant exchange period and the controller
  # exchange period must be equal. To change it, set all three in the case override;
  # my_contr stops the run if its period differs from the plant's.
  plant.dt: 0.002
  plant.t_interval: 0.002
  magnetic_controller.in_out_msg_dt: 0.002

  # Controller my_contr (controllers/my_contr/muscle_controller_NICE_IMAS_iter_init.m):
  # 1 = on, 0 = off; change them in the case override.
  magnetic_controller.KCURR: 1            # CS/PF coil-current controller
  magnetic_controller.control_Ip: 0       # Ip control inside KCURR
  magnetic_controller.RZIp: 0             # R, Z, Ip controller
  magnetic_controller.VS: 0               # vertical stabilisation (needed with the unstable models)
  magnetic_controller.VS_control_mode: 2  # VS actuator: 1 VS1, 2 VS3, 3 VS1+VS3
  magnetic_controller.Shape_control: 0    # Shape-Ip control mode, 0 = off
  # Plasma position read by the controller (measurement and R/Z references): the linear
  # models move the magnetic axis; the boundary geometric axis is only the reference
  # passed through by the plant.
  magnetic_controller.plasma_position: magnetic_axis

  # Output. `../../../` climbs out of the instance's own work directory, so the entries
  # land next to the run's logs in <run_dir>/ rather than under instances/.
  sink_equilibrium.sink_uri: "imas:hdf5?path=../../../out_plant"
  sink_control.sink_uri: "imas:hdf5?path=../../../out_controller"
  sink_equilibrium.sink_mode: "w"
  sink_control.sink_mode: "w"

  # Live figures (m3dash): coil currents, passive currents and applied coil voltages; the
  # recorder writes Zarr stores under <run_dir>/instances/recorder_plant/workdir/<port>/.
  recorder_plant.config: ${PDS_REPO}/visualization/linear_model_currents.py

  muscle_remote_log_level: 'INFO'
