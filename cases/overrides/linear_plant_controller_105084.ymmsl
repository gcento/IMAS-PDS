ymmsl_version: v0.2
# Pulse 105084, linear_plant_controller (the 105073 override lists the other settings).
# The NICE models of linear_models/ are linearisations of pulse 105073, so this shot uses
# linear_models/plasmaless_model, the plasma-free circuit model: an absolute model started
# from the F_INIT coil currents projected on the circuits (plant.operating_point does not
# apply).
# Initial state: the metis_nice_inverse_from_dina run of 105084 (nice_out); remove the
# preprocess.source_uri line to use an inverse_convergence run of 105084 instead (the
# workflow default). Flattop window 136.0 to 256.0 s, t0 = 136.2276 s; plant.t_end 140.0:
# about 1,900 exchanges at dt 0.002.
settings:
  preprocess.source_uri: "imas:hdf5?path=${PDS_REPO}/cases/runs/metis_nice_inverse_from_dina_105084/nice_out"
  source.t_min: 136.0
  source.t_max: 256.0
  plant.t_end: 140.0
  plant.linear_model_dir: "${PDS_REPO}/local_installs/plasmaless-tokamak-circuits/linear_models/plasmaless_model"
