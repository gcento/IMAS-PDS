ymmsl_version: v0.2
# Per-shot override for metis_nice_evol_from_dina, shot 105073 (DINA data: 39 slices,
# 5.918-207.764 s). t_min is the 16th slice (84.4176 s). Window length (0.55 s) and time step
# (10 ms) are those of the 105084 override, so that the two shots can be compared.
settings:
  source_nice.t_min: 84.41759781205512
  source_metis.t_min: 84.41759781205512
  
  metis_init.metis_clock_time_dt: 0.001

  metis.metis_clock_time_dt: 0.001

  nice_evo_rd.t_end: 86.0
  nice_evo_rd.t_interval: 0.001
  nice_evo_rd.dt: 0.001

  # Controller settings
    # - keep in_out_msg_dt equal to plant.dt and plant.t_interval
    # - when running VS control use dt = 0.001, if only KCURR dt=0.002 is fine
    # - the options for plasma position are magnetic_axis and geometric_axis
  magnetic_controller.KCURR: 1
  magnetic_controller.control_Ip: 0
  magnetic_controller.RZIp: 0
  magnetic_controller.VS: 1
  magnetic_controller.VS_control_mode: 3  #{'Off (0)'; 'VS1 (1)'; 'VS3 (2)'; 'VS1+VS3 (3)'}
  magnetic_controller.in_out_msg_dt: 0.001
  magnetic_controller.plasma_position: 'magnetic_axis'