ymmsl_version: v0.2
# Pulse 105073, linear_plant_controller. A key set here wins over
# workflows/linear_plant_controller/settings.ymmsl. After any change recreate the case
# (bin/pds-create-case linear_plant_controller 105073). Models:
# local_installs/plasmaless-tokamak-circuits/linear_models/README.md.
#
# Initial state and controller references: the inverse_convergence run of 105073
# (preprocess.source_uri, workflow default), window source.t_min/t_max. Its slices near
# the NICE linearisation time are 79.2176, 84.3176, 89.7176 s: with t_min 84.0 the run
# starts at t0 = 84.3176 s, 0.1 s before the linearisation time 84.4176 s. plant.t_end must
# not exceed the last slice inside the window.
settings:
  source.t_min: 84.0
  source.t_max: 200.0
  #source.source_uri:    default is nice out from inverse conv

  # Linear model settings
    # - keep only one model dir active
    # - operating point decides where the initial state is taken: from the 
    #   linearization equilibrium written in linear_model.json (plant.operating_point: descriptor)
    #   or from f_init from the precomputed nice inverse equilibrium (plant.operating_point: f_init)
    # - plasmaless_model (no plasma) is absolute: it always starts from the f_init coil currents
  plant.t_end: 87.0
  #plant.linear_model_dir: "${PDS_REPO}/local_installs/plasmaless-tokamak-circuits/linear_models/niceSimpleLin_105073_t84.4176"
  #plant.linear_model_dir: "${PDS_REPO}/local_installs/plasmaless-tokamak-circuits/linear_models/niceLin_105073_t84.4176"
  plant.linear_model_dir: "${PDS_REPO}/local_installs/plasmaless-tokamak-circuits/linear_models/vertical_circuit_105073_t84.3176"
  #plant.linear_model_dir: "${PDS_REPO}/local_installs/plasmaless-tokamak-circuits/linear_models/plasmaless_model"
  plant.operating_point: descriptor
  #plant.operating_point: f_init
  plant.dt: 0.001
  plant.t_interval: 0.001

  # Controller settings
    # - keep in_out_msg_dt equal to plant.dt and plant.t_interval
    # - when running VS control use dt = 0.001, if only KCURR dt=0.002 is fine
    # - the options for plasma position are magnetic_axis and geometric_axis
  magnetic_controller.KCURR: 1
  magnetic_controller.control_Ip: 0
  magnetic_controller.RZIp: 0
  magnetic_controller.VS: 1
  magnetic_controller.VS_control_mode: 3  #{'Off (0)'; 'VS1 (1)'; 'VS3 (2)'; 'VS1+VS3 (3)'}
  magnetic_controller.PSModel: 1
  magnetic_controller.Allocator: 1
  magnetic_controller.in_out_msg_dt: 0.001
  magnetic_controller.zdot_disturbance: 0
  magnetic_controller.zdot_filter: 0
  magnetic_controller.hold_references: 1
  magnetic_controller.plasma_position: 'magnetic_axis'
  
  